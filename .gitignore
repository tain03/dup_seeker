build/
*.spec

# Thư mục dist chứa bản đóng gói thường rất nặng, 
# bạn nên upload thủ công lên Release thay vì lưu trong Git
dist/
*.zip

# --- IDE & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# --- Project Specific ---
# Bỏ qua dữ liệu mẫu và kết quả đầu ra
DATA/*
!DATA/.gitkeep
OUTPUT/*
!OUTPUT/.gitkeep

# Agent
.agent
